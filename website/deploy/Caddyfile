# warmux.net: the website, with HTTPS certificates from Let's Encrypt
# (Caddy gets and renews them on its own)

# What both F-Droid repositories serve
(fdroid_repo) {
	@private not path /repo/*
	respond @private 404
	@index path /repo/entry.jar /repo/entry.json /repo/index* /repo/diff/*
	header @index Cache-Control "no-cache"
	file_server
}

warmux.net {
	root * /var/www/warmux.net
	encode zstd gzip
	file_server

	# GitHub tells us when a release is published or changed
	handle /hooks/release {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:9011
	}

	# The F-Droid repositories (warmux-fdroid): Warmux, and Warmux Testing.
	# Only their repo/ folders are public, not the signing key above them.
	# Their addresses, as shared, open the repository's page in a browser.
	redir /fdroid/repo /fdroid/repo/?{query}
	redir /testing/fdroid/repo /testing/fdroid/repo/?{query}
	handle_path /fdroid/* {
		root * /var/lib/warmux-fdroid/stable
		import fdroid_repo
	}
	handle_path /testing/fdroid/* {
		root * /var/lib/warmux-fdroid/testing
		import fdroid_repo
	}

	# The latest release and the testing pre-release, refreshed from
	# GitHub by warmux-latest (on GitHub's webhook, and hourly)
	@releases path /latest.json /testing.json
	handle @releases {
		root * /var/lib/warmux-web
		header Cache-Control "no-cache"
		file_server
	}

	# The game in the browser (packaging/web, built by CI as build/site/).
	# Its own folder, so publishing the site (rsync --delete) leaves it alone.
	redir /play /play/
	handle_path /play/* {
		root * /var/www/warmux-play
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
	# Stylesheets, scripts and the testing page are checked for changes on every visit (a
	# cheap 304 when unchanged); images are kept for a day
	@code path *.css *.js /testing/*
	header @code Cache-Control "no-cache"
	header /assets/img/* Cache-Control "public, max-age=86400"
	header / Cache-Control "public, max-age=600"

	# The game runs as WebAssembly, which needs 'wasm-unsafe-eval'; the rest
	# of the site gets none of that
	@site not path /play/*
	header @site Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header /play/* Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	# The game's page and code are checked for changes on every visit (a
	# cheap 304 when unchanged; the browser keeps warmux.data itself). Files
	# under lazy/ are asked for with their version in the address, so they
	# never change.
	@playcode path /play/ /play/index.html /play/*.js /play/*.css /play/*.wasm /play/*.data
	header @playcode Cache-Control "no-cache"
	header /play/lazy/* Cache-Control "public, max-age=31536000, immutable"
}

www.warmux.net {
	redir https://warmux.net{uri} permanent
}
