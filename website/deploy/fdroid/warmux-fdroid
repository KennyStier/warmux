#!/bin/sh
# Keeps the two F-Droid repositories up to date:
#   stable   https://warmux.net/fdroid/repo           Warmux (latest release)
#   testing  https://warmux.net/testing/fdroid/repo   Warmux Testing
# For each, downloads the Android APK named in the list warmux-latest just
# wrote, keeps the newest few, and has fdroidserver rebuild and sign the
# index when something changed. Both are signed with the same key. Started
# after each warmux-latest run.
set -eu
DIR=/var/lib/warmux-fdroid
SHARE=/usr/local/share/warmux-fdroid
LISTS=/var/lib/warmux-web
KEEP=3

# The signing key's password, made once
cd "$DIR"
if [ ! -s keypass ]; then
  (umask 077; head -c 32 /dev/urandom | base64 | tr -d '/+=' > keypass)
fi
FDROID_KEY_PASS=$(cat keypass)
export FDROID_KEY_PASS

update() {  # name list.json
  mkdir -p "$DIR/$1"
  cd "$DIR/$1"

  # Configuration and app description come from the repository; fdroid
  # copies the icon (repo_icon) from here into repo/icons
  install -m600 "$SHARE/$1/config.yml" config.yml
  rm -rf metadata && cp -r "$SHARE/$1/metadata" metadata
  install -m644 "$SHARE/warmux.png" warmux.png

  changed=no
  [ -f ../keystore.p12 ] || { fdroid update --create-key -q; changed=yes; }
  [ -f repo/entry.jar ] || changed=yes
  cmp -s warmux.png repo/icons/warmux.png || changed=yes
  mkdir -p repo

  if [ -f "$LISTS/$2" ]; then
    for url in $(jq -r '.assets[] | select(.name | endswith("-android.apk")) | .url' "$LISTS/$2"); do
      apk=$(basename "$url")
      case "$apk" in *[!A-Za-z0-9._-]*) echo "odd file name: $apk" >&2; continue;; esac
      [ -f "repo/$apk" ] && continue
      echo "$1: downloading $apk"
      curl -fsSL --max-time 600 -A "warmux.net-fdroid" -o "repo/.$apk.part" "$url"
      mv "repo/.$apk.part" "repo/$apk"
      changed=yes
    done
  fi

  # Keep the newest few
  for old in $(ls -t repo/*.apk 2>/dev/null | tail -n +$((KEEP + 1))); do
    echo "$1: removing $old"
    rm -f "$old"
    changed=yes
  done

  # Also when the APKs differ from those of the last index (removed by hand)
  apks=$(ls repo/*.apk 2>/dev/null | xargs -r -n1 basename | tr '\n' ' ')
  [ "$apks" = "$(cat .indexed 2>/dev/null)" ] || changed=yes

  if [ $changed = yes ]; then
    fdroid update -q --use-date-from-apk
    echo "$apks" > .indexed
    echo "$1: index updated: $apks"
  fi
}

update stable latest.json
update testing testing.json
